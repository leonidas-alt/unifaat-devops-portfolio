# =============================================
# iam.tf - IAM Role + Instance Profile para EC2
# TechNova - Emilly Santos de Oliveira (4023575)
# =============================================
#
# ★ BÔNUS: Instance Profile com permissão mínima.
#   A EC2 recebe apenas permissão de leitura no
#   bucket de state (para consulta de evidências)
#   e acesso ao SSM Session Manager (alternativa ao SSH).
# =============================================

# ── Trust Policy ──────────────────────────────
# Permite que o serviço EC2 assuma esta role

data "aws_iam_policy_document" "ec2_trust" {
  statement {
    sid     = "AllowEC2AssumeRole"
    effect  = "Allow"
    actions = ["sts:AssumeRole"]

    principals {
      type        = "Service"
      identifiers = ["ec2.amazonaws.com"]
    }
  }
}

# ── IAM Role ──────────────────────────────────

resource "aws_iam_role" "ec2_role" {
  name               = "technova-ec2-role-aula05"
  description        = "IAM Role para EC2 TechNova - Aula 05"
  assume_role_policy = data.aws_iam_policy_document.ec2_trust.json

  tags = {
    Name = "technova-ec2-role-aula05"
  }
}

# ── Policy: SSM Session Manager ───────────────
# Permite acesso à instância via AWS Systems Manager
# (alternativa ao SSH - não precisa abrir porta 22)

resource "aws_iam_role_policy_attachment" "ssm" {
  role       = aws_iam_role.ec2_role.name
  policy_arn = "arn:aws:iam::aws:policy/AmazonSSMManagedInstanceCore"
}

# ── Policy: CloudWatch Logs ───────────────────
# Permite que o EC2 envie logs do user_data para o CloudWatch

resource "aws_iam_role_policy_attachment" "cloudwatch_logs" {
  role       = aws_iam_role.ec2_role.name
  policy_arn = "arn:aws:iam::aws:policy/CloudWatchLogsFullAccess"
}

# ── Instance Profile ──────────────────────────
# Wrapper necessário para associar a Role à instância EC2

resource "aws_iam_instance_profile" "ec2_profile" {
  name = "technova-ec2-profile-aula05"
  role = aws_iam_role.ec2_role.name

  tags = {
    Name = "technova-ec2-profile-aula05"
  }
}
